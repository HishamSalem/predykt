# Normalise all text to LF in the repository. Without this the stored line
# endings depend on each contributor's core.autocrlf, and a single commit from
# a differently-configured machine rewrites whole files in the diff.
* text=auto eol=lf

*.py   text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.cff  text eol=lf
*.cfg  text eol=lf
*.txt  text eol=lf

# Never touch these.
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.whl  binary
*.ipynb -text
